{
  "exclusive": true,
  "reload_style_on_change": true,
  "position": "top",
  "spacing": 0,
  "height": 24,
  "margin-top": 1,
  "width": 1440,
  "modules-left": [
    "clock",
    "mpris"
  ],
  "modules-center": [
    "hyprland/workspaces"
  ],
  "modules-right": [
    "tray",
    "bluetooth",
    "pulseaudio#output"
  ],
  "hyprland/workspaces": {
    "on-click": "activate",
    "format": "{icon}",
    "format-icons": {
      "default": "",
      "active": "󰮯",
      "empty": "",
      "focused": ""
    }
  },
  "clock": {
    "format": " {:%H:%M %Y-%m-%d}",
    "format-alt": "{:L%d %B W%V %Y}",
    "tooltip-format": "<span>{calendar}</span>",
    "calendar": {
      "mode": "month",
      "mode-mon-col": 3,
      "on-click-right": "mode",
      "format": {
        "month": "<span color='#ffead3'><b>{}</b></span>",
        "weekdays": "<span color='#ffcc66'><b>{}</b></span>",
        "today": "<span color='#ff6699'><b>{}</b></span>"
      }
    }
  },
  "bluetooth": {
    "format": "",
    "format-disabled": "󰂲",
    "format-connected": "󰂱",
    "tooltip-format": "Devices connected: {num_connections}",
    "on-click": "blueman-manager"
  },
  "pulseaudio#output": {
    "format": "{icon}  {volume}%",
    "tooltip-format": "{icon}  {volume}%",
    "format-muted": " off",
    "format-icons": {
      "default": [
        ""
      ]
    },
    "max-volume": 100,
    "scroll-step": 5,
    "smooth-scrolling-threshold": 1,
    "on-click": "pavucontrol"
  },
  "mpris": {
    "format": "󰋎 {title}",
    "format-paused": "<i><span color='grey'>{status_icon} {artist}</span></i>",
    "max-length": 20,
    "player-icons": {
      "default": "⏸",
      "mpv": "🎵"
    },
    "status-icons": {
      "paused": "󰋐"
    }
  },
  "tray": {
    "icon-size": 13,
    "spacing": 5,
    "show-passive-items": true
  }
}
